rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /negocios/{codigo}/{coleccion}/{id} {
      // Lectura, alta y modificación: solo con sesión (anónima) y el código largo del negocio.
      allow read, create, update: if request.auth != null && codigo.size() >= 16;
      // Nada financiero se borra: los errores se corrigen anulando o rectificando.
      allow delete: if false;
    }
  }
}
